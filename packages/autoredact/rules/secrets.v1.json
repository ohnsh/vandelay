{
  "version": "secrets/1",
  "rules": [
    {
      "id": "credential-token",
      "severity": "high",
      "pattern": "\\b(?:sk-[A-Za-z0-9_-]{12,}|gh[pousr]_[A-Za-z0-9_]{12,}|github_pat_[A-Za-z0-9_]{12,}|xox[baprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{12,})\\b",
      "flags": ""
    },
    {
      "id": "jwt",
      "severity": "high",
      "pattern": "\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}(?:\\.[A-Za-z0-9_-]+)?",
      "flags": ""
    },
    {
      "id": "authorization",
      "severity": "high",
      "pattern": "\\b(?:bearer|basic)\\s+[A-Za-z0-9+/_.=~-]{6,}",
      "flags": "i"
    },
    {
      "id": "secret-assignment",
      "severity": "review",
      "pattern": "[\\w.-]*(?:password|passwd|pwd|secret|token|api[_ -]?key|access[_ -]?key|private[_ -]?key)[\\w.-]*\\s*[\"']?\\s*[:=]\\s*\\S+",
      "flags": "i"
    },
    {
      "id": "credential-url",
      "severity": "high",
      "pattern": "[a-zA-Z][a-zA-Z0-9+.-]*://[^\\s/@:]+:[^\\s/@]+@",
      "flags": ""
    },
    {
      "id": "secret-query",
      "severity": "review",
      "pattern": "[?&](?:token|key|password|secret|signature|sig|code)=[^\\s&#]+",
      "flags": "i"
    },
    {
      "id": "private-key",
      "severity": "high",
      "pattern": "(?:BEGIN|END)\\s+(?:[A-Z0-9]+\\s+)?PRIVATE\\s+KEY",
      "flags": "i"
    },
    {
      "id": "credential-field-text",
      "severity": "review",
      "pattern": "^[ \\t]*(?:(?:global|account|access|secret)[ \\t]+)?(?:api[ \\t]*key|api[ \\t]*token|access[ \\t]*token|secret(?:[ \\t]*key)?|password|token)[ \\t]*[:=]?[ \\t]*\\r?\\n[ \\t]*[A-Za-z0-9_+/=.-]{16,}[ \\t]*$",
      "flags": "im"
    },
    {
      "id": "one-time-code",
      "severity": "review",
      "pattern": "(?:verification|security|one.?time|recovery|backup)[\\s_-]+code\\s*[:=]?\\s*\\S+",
      "flags": "i"
    }
  ]
}
