  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.58.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  }
}
